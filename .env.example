# Fictalent RH · configuração local (12-factor)
#
# 1. Copie para .env:          cp .env.example .env
# 2. Troque TODA senha abaixo por um valor gerado. Use só letras e números (hex):
#                              openssl rand -hex 24
#    O manual (docs/08_manual_de_operacao.md) tem um comando que gera todas de uma vez.
# 3. O .env nunca é versionado (.gitignore). Sem ele, o compose se recusa a subir.
#
# Portas publicadas só em 127.0.0.1: nada fica acessível a partir da rede.

# ─── Origem: o sistema simulado (Postgres) ───
ORIGEM_DB=db_fictalent
ORIGEM_ADMIN_USER=fictalent_admin
ORIGEM_ADMIN_PASSWORD=troque-por-openssl-rand-hex-24
ORIGEM_PORT=5441

# ─── Staging: o espelho de onde o pipeline lê (Postgres) ───
STAGING_DB=stg_fictalent
STAGING_ADMIN_USER=fictalent_admin
STAGING_ADMIN_PASSWORD=troque-por-openssl-rand-hex-24
STAGING_PORT=5442

# ─── Metadados do Dagster (Postgres, sem porta publicada) ───
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=troque-por-openssl-rand-hex-24

# ─── Lake: armazenamento compatível com S3 (SeaweedFS) ───
S3_ACCESS_KEY=troque-por-openssl-rand-hex-12
S3_SECRET_KEY=troque-por-openssl-rand-hex-24
S3_BUCKET=fictalent-lake
S3_PORT=8333

# ─── Warehouse dimensional (MySQL) ───
DW_DB=dw_fictalent
DW_ROOT_PASSWORD=troque-por-openssl-rand-hex-24
DW_CARGA_USER=fictalent_carga
DW_CARGA_PASSWORD=troque-por-openssl-rand-hex-24
DW_PORT=3316

# ─── Interfaces ───
DAGSTER_PORT=3010
GRAFANA_PORT=3011
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-openssl-rand-hex-24

# ─── Usuário só de leitura que o Grafana usa nos bancos ───
GRAFANA_LEITOR_PASSWORD=troque-por-openssl-rand-hex-24
