# Configuração do projeto (12-factor). Copie para .env e ajuste; o .env NUNCA é versionado.

# --- Staging Postgres (docker compose em staging/) ---
STAGING_DB=db_fictitur
STAGING_USER=fictitur
STAGING_PASSWORD=troque-esta-senha
STAGING_PORT=5433

# --- Lake (bronze/silver/gold em parquet; URL fsspec) ---
# Padrão: data/lake (local, gitignorado). Para S3/MinIO: s3://bucket/caminho
# LAKE_URL=data/lake

# --- Warehouse multidimensional (docker compose, servico "warehouse") ---
DW_DB=dw_fictitur
DW_USER=fictitur
DW_PASSWORD=troque-esta-senha-tambem
DW_PORT=5434
# Carga seletiva por particao (ex.: 2024,2025,2026). Vazio = todos os anos.
# DW_ANOS=

# Para apontar a carga a um Postgres externo (ex.: Neon), sobrescreva DW_HOST/DW_PORT/etc.
# DW_HOST=localhost
#
# Ou informe a string de conexao completa (tem precedencia sobre as partes acima):
# DW_URL=postgresql://usuario:senha@host.regiao.aws.neon.tech/neondb?sslmode=require
# Dica: guarde o destino em nuvem num arquivo separado (.env.neon, gitignorado) e rode
#   uv run carga-dw --env .env.neon
# O .env continua apontando para o container local.
